+// Static backdrops are stored in a flat vector and do not participate in the
+// ObjectList selection chain.  This iterator keeps event traversal type-safe;
+// deselection is intentionally inert for the compatibility path.
+class FlatObjectIterator
+{
+public:
+    FlatObjectList & items;
+    size_t index;
+
+    FlatObjectIterator(FlatObjectList & list)
+    : items(list), index(0)
+    {
+    }
+
+    FrameObject * operator*() const
+    {
+        return items[index];
+    }
+
+    void operator++()
+    {
+        index++;
+    }
+
+    void operator++(int)
+    {
+        ++*this;
+    }
+
+    void deselect()
+    {
+    }
+
+    bool end() const
+    {
+        return index >= items.size();
+    }
+};
