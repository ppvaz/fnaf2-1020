{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chronicle-entries-v1",
  "title": "fnaf2-1020 chronicle checkpoint",
  "type": "object",
  "required": ["schema", "checkpoint", "label", "entries"],
  "properties": {
    "schema": {"const": "chronicle-entries-v1"},
    "checkpoint": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
    "label": {"type": "string", "minLength": 1},
    "outlook": {"$ref": "#/$defs/outlook"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "outlook": {
      "type": "object",
      "required": ["next", "missing"],
      "properties": {
        "next": {"type": "array", "items": {"$ref": "#/$defs/outlookItem"}},
        "missing": {"type": "array", "items": {"$ref": "#/$defs/outlookItem"}}
      },
      "additionalProperties": false
    },
    "outlookItem": {
      "type": "object",
      "required": ["title", "body", "sources"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "date", "kind", "title", "body", "measured", "label", "rung", "plan", "night", "route", "tags", "sources", "status", "supersededBy"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "date": {"type": "string", "format": "date"},
        "kind": {"enum": ["milestone", "lesson", "refutation", "retraction", "negative", "fact", "trivia"]},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "measured": {"type": ["string", "null"]},
        "label": {"enum": ["SOURCED", "CALIBRATED", "DEVICE_MEASURED", "INFERRED", "MODEL", "UNKNOWN"]},
        "rung": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
        "plan": {"type": ["integer", "null"], "minimum": 1, "maximum": 24},
        "night": {"type": ["integer", "null"], "minimum": 1, "maximum": 7},
        "route": {"type": ["string", "null"]},
        "tags": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"enum": ["standing", "superseded", "retracted"]},
        "supersededBy": {"type": ["string", "null"]}
      }
    }
  }
}
