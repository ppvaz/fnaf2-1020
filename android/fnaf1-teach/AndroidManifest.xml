<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ppvaz.fnaf1teach">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />

    <!-- The presenter is a user-approved, non-touchable overlay only. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.scottgames.fivenightsatfreddys" />
    </queries>

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:label="FNaF 1 Teach Presenter"
        android:theme="@style/Fnaf1TeachTheme">
        <activity
            android:name="com.ppvaz.fnaf1teach.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only adb's shell (which holds DUMP) may update the presenter's
             bounded state. It has no game-control, capture, or sensing API. -->
        <receiver
            android:name="com.ppvaz.fnaf1teach.Fnaf1TeachCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ppvaz.fnaf1teach.SHOW" />
                <action android:name="com.ppvaz.fnaf1teach.UPDATE" />
                <action android:name="com.ppvaz.fnaf1teach.CLEAR" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.ppvaz.fnaf1teach.Fnaf1TeachOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Non-interactive FNaF 1 teaching overlay while a user-approved game run is active." />
        </service>
    </application>
</manifest>
