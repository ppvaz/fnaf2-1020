<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fnaf2.cuehelper">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />

    <!-- Required by Android even though the control server binds only loopback. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Used only to observe the configured A2DP receiver on Android 12+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <queries>
        <package android:name="com.scottgames.fnaf2" />
    </queries>

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:icon="@mipmap/cue_helper_icon_adaptive"
        android:label="FNaF 2 Cue Helper"
        android:roundIcon="@mipmap/cue_helper_icon_adaptive"
        android:supportsRtl="true"
        android:theme="@style/CueHelperTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="false" />
    </application>
</manifest>
